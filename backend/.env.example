# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# LLM: cadeia de providers tentados em ordem. Se um cair em rate limit (429),
# tenta o proximo automaticamente. Cada provider tem sua propria chave/modelo.
LLM_CHAIN=groq,cerebras,gemini

# Groq — https://console.groq.com/keys (Llama 3.3 70B gratis com 100k tokens/dia)
LLM_GROQ_API_KEY=
LLM_GROQ_MODEL=llama-3.3-70b-versatile

# Cerebras — https://cloud.cerebras.ai/platform/keys (Llama 3.3 70B gratis)
LLM_CEREBRAS_API_KEY=
LLM_CEREBRAS_MODEL=llama-3.3-70b

# Google Gemini — https://aistudio.google.com/apikey (Gemini Flash gratis)
LLM_GEMINI_API_KEY=
LLM_GEMINI_MODEL=gemini-2.0-flash-lite

# Embeddings (local, sem chave)
EMBEDDING_MODEL=BAAI/bge-m3

# App
CORS_ORIGINS=http://localhost:5173
