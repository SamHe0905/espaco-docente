# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# LLM primario (Groq por padrão)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# LLM fallback opcional — se o primario der rate limit, tenta este automaticamente
# Crie conta em https://cloud.cerebras.ai (Llama 3.3 70B gratuito) e preencha:
LLM_FALLBACK_PROVIDER=cerebras
LLM_FALLBACK_MODEL=llama-3.3-70b
LLM_FALLBACK_API_KEY=

# Embeddings (local, sem chave)
EMBEDDING_MODEL=BAAI/bge-m3

# App
CORS_ORIGINS=http://localhost:5173
